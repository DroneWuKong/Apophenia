<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Pre-Android-12 has no separate cloud/device-transfer rule. Fail closed: explicit
         in-app export/backup is the only supported off-device path. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
